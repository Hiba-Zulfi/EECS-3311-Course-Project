obj=User~u
obj=BakingGUI~g
obj=AgentController~c
obj=BakingAgent~a
obj=ToolManager~tm
obj=UserPreferences~up
obj=TasteCustomizationTool~tct
obj=LLMClient~lc
obj=LLMService~llm
u-&gt;g : enter taste request
g-&gt;c : processRequest(request)
c-&gt;a : processRequest(request)
a-&gt;lc : analyzeRequest(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;a : intent
