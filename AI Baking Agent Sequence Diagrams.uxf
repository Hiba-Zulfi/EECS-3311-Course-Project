    <panel_attributes>title=SD04 Find Ingredient Substitution for UC05 extends UC04
obj=User~u
obj=BakingGUI~g
obj=AgentController~c
obj=BakingAgent~a
obj=ToolManager~tm
obj=SubstitutionTool~st
obj=IngredientManager~im
obj=LLMClient~lc
obj=LLMService~llm
u-&gt;g : select missing ingredient
g-&gt;c : processRequest(request)
c-&gt;a : processRequest(request)
a-&gt;lc : analyzeRequest(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;a : intent
a-&gt;tm : getTool(SubstitutionTool)
tm.&gt;a : SubstitutionTool
a-&gt;st : execute(ingredient, recipe)
st-&gt;im : findMissingIngredients(recipe)
im.&gt;st : missing ingredients
st-&gt;lc : generateResponse(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;st : response text
st.&gt;a : substitute from suggestSubstitute and effect from explainEffect
a.&gt;c : substitute from suggestSubstitute and effect from explainEffect
c.&gt;g : substitute from suggestSubstitute and effect from explainEffect
g.&gt;u : displayResult(substitute)</panel_attributes>
