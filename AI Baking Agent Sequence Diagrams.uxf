    <panel_attributes>title=SD02 Time Based Recommendation for UC03 includes UC02
obj=User~u
obj=BakingGUI~g
obj=AgentController~c
obj=BakingAgent~a
obj=ToolManager~tm
obj=RecipeSearchTool~rst
obj=TimeRecommendationTool~trt
obj=LLMClient~lc
obj=LLMService~llm
u-&gt;g : enter available time
g-&gt;c : submitRequest(request)
c-&gt;a : processRequest(request)
a-&gt;lc : analyzeRequest(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;a : intent
a-&gt;tm : getTool(RecipeSearchTool)
tm.&gt;a : RecipeSearchTool
a-&gt;rst : execute(criteria)
rst-&gt;lc : generateResponse(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;rst : response text
rst.&gt;a : List of Recipe from searchRecipes
a-&gt;tm : getTool(TimeRecommendationTool)
tm.&gt;a : TimeRecommendationTool
a-&gt;trt : execute(recipes, availableTime)
trt-&gt;lc : rankOptions(options)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;trt : ranked options
trt.&gt;a : ranked recipes from filterByTime and rankRecipes
a.&gt;c : ranked recipes from filterByTime and rankRecipes
c.&gt;g : ranked recipes from filterByTime and rankRecipes
g.&gt;u : displayRecipe(recipe)</panel_attributes>
