    <panel_attributes>title=SD01 Submit Baking Request for UC01 includes UC02
obj=User~u
obj=BakingGUI~g
obj=AgentController~c
obj=BakingAgent~a
obj=ToolManager~tm
obj=BakingRequestTool~brt
obj=RecipeSearchTool~rst
obj=LLMClient~lc
obj=LLMService~llm
u-&gt;g : enter request, click Submit (submitRequest)
g-&gt;c : processRequest(request)
c-&gt;a : processRequest(request)
a-&gt;lc : analyzeRequest(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;a : intent
a-&gt;tm : getTool(BakingRequestTool)
tm.&gt;a : BakingRequestTool
a-&gt;brt : execute(requestText)
brt-&gt;lc : generateResponse(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;brt : response text
brt.&gt;a : requirements from identifyRequirements
a-&gt;tm : getTool(RecipeSearchTool)
tm.&gt;a : RecipeSearchTool
a-&gt;rst : execute(requirements)
rst-&gt;lc : generateResponse(prompt)
lc-&gt;llm : HTTP request
llm.&gt;lc : JSON response
lc.&gt;rst : response text
rst.&gt;a : List of Recipe from searchRecipes
a.&gt;c : result
c.&gt;g : result
g.&gt;u : displayRecipe(recipe)</panel_attributes>
    <additional_attributes/>
  </element>
