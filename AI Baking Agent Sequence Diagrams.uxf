    <panel_attributes>title=SD03 Check Availability and Generate Shopping List for UC04 and UC08 includes UC04
obj=User~u
obj=BakingGUI~g
obj=AgentController~c
obj=Recipe~r
obj=IngredientManager~im
obj=ShoppingList~sl
u-&gt;g : enter available ingredients
g-&gt;c : checkIngredients(recipe, ingredients)
c-&gt;r : getIngredients()
r.&gt;c : List of Ingredient required
c-&gt;im : compareIngredients(required, available)
im.&gt;c : missing ingredients
c.&gt;g : missing ingredients
g.&gt;u : displayResult(result)
u-&gt;g : click Generate Shopping List
g-&gt;c : generateShoppingList(recipe, ingredients)
c-&gt;r : getIngredients()
r.&gt;c : List of Ingredient required
c-&gt;im : compareIngredients(required, available)
im.&gt;c : missing ingredients
c-&gt;sl : addItem(item) for each missing item
sl.&gt;c : ShoppingList
c.&gt;g : ShoppingList
g.&gt;u : displayResult(shoppingList)</panel_attributes>
    <additional_attributes/>
  </element>
